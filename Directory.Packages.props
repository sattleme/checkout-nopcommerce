<Project>
  <!--
    The packages of this repository's own projects, one exact version each (README.md,
    "Dependencies"); the lockfiles (packages.lock.json) pin what they bring, and CI restores them in
    locked mode. The plugin itself references no package: nopCommerce brings its framework, and the
    SDK, NBitcoin.Secp256k1 and the QR code generator are compiled from their pinned sources.
    The tests: the latest release of each, on nopCommerce 5.00's framework, net10.0.
  -->
  <ItemGroup Label="The tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>
</Project>
